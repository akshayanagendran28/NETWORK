class Solution {
    public int totalHammingDistance(int[] nums) {
        int totalDistance = 0;
        int n = nums.length;
        
        for (int bit = 0; bit < 30; bit++) {
            int onesCount = 0;
            for (int num : nums) {
                onesCount += (num >> bit) & 1;
            }
            int zerosCount = n - onesCount;
            totalDistance += onesCount * zerosCount;
        }
        
        return totalDistance;
    }
}
