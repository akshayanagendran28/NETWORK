#include <vector>
#include <deque>

using namespace std;

class Solution {
public:
    vector<int> maxSlidingWindow(vector<int>& nums, int k) {
        if (nums.empty() || k == 0) {
            return {};
        }
        
        vector<int> result;
        // Store indices of elements in a strictly decreasing order of values
        deque<int> deq;
        
        for (int i = 0; i < nums.size(); ++i) {
            // 1. Remove indices that are out of the current window bounds
            if (!deq.empty() && deq.front() < i - k + 1) {
                deq.pop_front();
            }
            
            // 2. Maintain monotonic property: remove elements smaller than current element
            while (!deq.empty() && nums[deq.back()] < nums[i]) {
                deq.pop_back();
            }
            
            // 3. Add current element's index to the back of the deque
            deq.push_back(i);
            
            // 4. Once the initial window size k is reached, append the max to result
            if (i >= k - 1) {
                result.push_back(nums[deq.front()]);
            }
        }
        
        return result;
    }
};
