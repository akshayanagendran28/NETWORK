#include <stdio.h>
#include <string.h>

int main()
{
    int T;
    scanf("%d", &T);

    while(T--)
    {
        char s[1001];
        int sum = 0;
        int i;

        scanf("%s", s);

        for(i = 0; s[i] != '\0'; i++)
        {
            if(s[i] >= '0' && s[i] <= '9')
            {
                sum = sum + (s[i] - '0');
            }
        }

        printf("%d\n", sum);
    }

    return 0;
}
