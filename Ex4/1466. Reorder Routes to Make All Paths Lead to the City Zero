#include <vector>
#include <cmath>
#include <queue>

using namespace std;

class Solution {
public:
    int minReorder(int n, vector<vector<int>>& connections) {
        // adj[u] will store pairs of {neighbor, is_original_direction}
        // is_original_direction is 1 if the road goes from u -> neighbor, 0 otherwise
        vector<vector<pair<int, int>>> adj(n);
        
        for (const auto& conn : connections) {
            int u = conn[0];
            int v = conn[1];
            adj[u].push_back({v, 1}); // Original road: u -> v
            adj[v].push_back({u, 0}); // Reverse path for traversal: v -> u
        }
        
        int changeCount = 0;
        vector<bool> visited(n, false);
        queue<int> q;
        
        // Start BFS from the capital (city 0)
        q.push(0);
        visited[0] = true;
        
        while (!q.empty()) {
            int curr = q.front();
            q.pop();
            
            for (const auto& neighborPair : adj[curr]) {
                int neighbor = neighborPair.first;
                int isOriginal = neighborPair.second;
                
                if (!visited[neighbor]) {
                    visited[neighbor] = true;
                    // If the original road points away from the capital (curr -> neighbor),
                    // we must change its direction.
                    if (isOriginal == 1) {
                        changeCount++;
                    }
                    q.push(neighbor);
                }
            }
        }
        
        return changeCount;
    }
};

