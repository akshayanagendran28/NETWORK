#include <vector>
#include <climits>
#include <algorithm>

using namespace std;

class Solution {
public:
    int findCheapestPrice(int n, vector<vector<int>>& flights, int src, int dst, int k) {
        // Prices array to store the minimum cost to reach each city.
        // Initialize all cities to infinity (impossible to reach initially).
        vector<int> prices(n, INT_MAX);
        prices[src] = 0; // The cost to stay at the source is 0.

        // We can make at most k stops, which translates to k + 1 flights.
        for (int i = 0; i <= k; ++i) {
            // Create a copy of the current prices to prevent updating paths 
            // multiple times within the same flight iteration.
            vector<int> tempPrices = prices;

            for (const auto& flight : flights) {
                int u = flight[0];     // Source city of flight
                int v = flight[1];     // Destination city of flight
                int price = flight[2]; // Cost of flight

                // If the source city u is reachable from the previous iteration
                if (prices[u] != INT_MAX) {
                    // Update the destination price if a cheaper path is found
                    if (prices[u] + price < tempPrices[v]) {
                        tempPrices[v] = prices[u] + price;
                    }
                }
            }
            // Update the main prices array with the discoveries from this iteration
            prices = tempPrices;
        }

        // Return the final price to destination, or -1 if it was never reached
        return (prices[dst] == INT_MAX) ? -1 : prices[dst];
    }
};

