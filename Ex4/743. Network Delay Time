#include <vector>
#include <queue>
#include <climits>
#include <algorithm>

using namespace std;

class Solution {
public:
    int networkDelayTime(vector<vector<int>>& times, int n, int k) {
        // Create an adjacency list: adj[u] stores pairs of {v, weight}
        vector<vector<pair<int, int>>> adj(n + 1);
        for (const auto& edge : times) {
            int u = edge[0];
            int v = edge[1];
            int w = edge[2];
            adj[u].push_back({v, w});
        }

        // Distance array to store the shortest time to reach each node.
        // Initialize all distances to infinity.
        vector<int> dist(n + 1, INT_MAX);
        
        // Min-heap priority queue storing pairs of {distance, node}
        priority_queue<pair<int, int>, vector<pair<int, int>>, greater<pair<int, int>>> pq;

        // Base case: distance to the source node k is 0
        dist[k] = 0;
        pq.push({0, k});

        while (!pq.empty()) {
            auto [d, u] = pq.top();
            pq.pop();

            // Skip processing if we have already found a shorter path to u
            if (d > dist[u]) {
                continue;
            }

            // Explore all neighbors of node u
            for (const auto& neighbor : adj[u]) {
                int v = neighbor.first;
                int w = neighbor.second;

                // Relaxation step: if a shorter path to v is found
                if (dist[u] + w < dist[v]) {
                    dist[v] = dist[u] + w;
                    pq.push({dist[v], v});
                }
            }
        }

        int maxTime = 0;
        // Find the maximum time taken to reach any node from 1 to n
        for (int i = 1; i <= n; ++i) {
            if (dist[i] == INT_MAX) {
                return -1; // Node i is unreachable
            }
            maxTime = max(maxTime, dist[i]);
        }

        return maxTime;
    }
};

